NEXT_PUBLIC_WORDPRESS_API_URL=https://salaf.maschandigital.id/wp-json/wp/v2
NEXT_PUBLIC_SITE_URL=https://banten-mengaji.vercel.app

# JWT Secret untuk otentikasi session Next.js (wajib diisi, minimal 32 karakter acak)
# Panduan generate key aman di terminal: openssl rand -base64 32
JWT_SECRET=

# Kredensial Administrator WordPress (Application Password untuk operasi backend)
WP_ADMIN_USERNAME=
WP_APPLICATION_PASSWORD=

# Konfigurasi Notifikasi Email Mailketing API v1
MAILKETING_API_TOKEN=
MAILKETING_FROM_EMAIL=admin@maschandigital.id
MAILKETING_DKM_LIST_ID=92693
ADMIN_NOTIFICATION_EMAIL=admin@maschandigital.id

# Konfigurasi Web Push Notification (VAPID)
# Panduan generate VAPID keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@maschandigital.id

# Webhook Cross-Posting Dakwah ke Media Sosial (Header x-webhook-secret)
# Panduan generate secret aman: openssl rand -hex 24
WEBHOOK_SECRET=
GEMINI_API_KEY=
META_PAGE_ID=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Remote MCP Server & OAuth Authentication
AGENT_SECRET_KEY=
GITHUB_TOKEN=
